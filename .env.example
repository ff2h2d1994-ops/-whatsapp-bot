# WhatsApp Configuration
WHATSAPP_TOKEN=your_whatsapp_business_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFY_TOKEN=your_random_secure_verify_token_here
GRAPH_API_VERSION=v20.0

# Google Sheets Configuration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n

# Note: Never commit .env file to GitHub!
# Add all these secrets in Cloudflare Dashboard:
# Workers & Pages → whatsapp-leads-bot → Settings → Variables and Secrets
